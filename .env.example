# Backend address. Leave unset in development: the app uses the IP of the
# machine running `npx expo start` with port 8005. Set it for a deployed server.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8005

# Optional Supabase auth. Without these, the app runs in demo mode.
# EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
